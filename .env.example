# =====================================================
# GlobePilots Environment Variables
# Copy this file to .env.local and fill in your values
# =====================================================

# =====================================================
# SEO
# =====================================================
# Google Search Console HTML-tag verification (the content="..." value).
# Optional — only needed if not verifying via DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# =====================================================
# Database - Supabase
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =====================================================
# Authentication - NextAuth.js
# =====================================================
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional, for Google Sign In)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =====================================================
# Travel APIs
# =====================================================
# SerpApi (Google Flights/Travel Explore/Hotels; server-only secret)
SERPAPI_KEY=your_serpapi_key

# TravelPayouts API
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token
TRAVELPAYOUTS_MARKER=your_travelpayouts_marker

# Kiwi Tequila API (primary flight search — covers LCCs)
# Sign up at https://tequila.kiwi.com/
KIWI_API_KEY=your_kiwi_api_key

# =====================================================
# Affiliate Monetization
# =====================================================
# MASTER SWITCH: affiliate tracking + live booking are disabled unless this is
# exactly "false". NEXT_PUBLIC_* vars are inlined at BUILD time — changing them
# in Vercel requires a redeploy to take effect.
NEXT_PUBLIC_STEALTH_MODE=true

# TravelPayouts/Aviasales flight links (tp.media wrapper). Fall back to the
# original hardcoded values if unset.
# Used by a client-side nearby-price helper. Treat this as public and use only
# a provider token that is explicitly safe for browser use.
NEXT_PUBLIC_TRAVELPAYOUTS_TOKEN=
NEXT_PUBLIC_TP_MARKER=708764
NEXT_PUBLIC_TP_CAMPAIGN_ID=100
NEXT_PUBLIC_TP_TRS=505363

# Per-partner IDs — each partner activates automatically when its ID is set
# (and stealth is off). Leave blank until the program approves you.
# Agoda affiliate cid (hotels)
NEXT_PUBLIC_AGODA_CID=
# GetYourGuide partner id (activities, worldwide)
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
# Klook affiliate id (activities, SE Asia)
NEXT_PUBLIC_KLOOK_AID=
# WayAway partner id (cashback flight search, optional)
NEXT_PUBLIC_WAYAWAY_PARTNER_ID=
# JetRadar marker (alternative flight meta, optional)
NEXT_PUBLIC_JETRADAR_MARKER=
# Kiwi affiliate routing (opt-in; Kiwi deep links carry no tracking yet, so
# leaving this off keeps flights on Aviasales, which earns)
NEXT_PUBLIC_KIWI_AFFILIATE=false

# =====================================================
# AI APIs
# =====================================================
# DeepSeek API (primary AI provider)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Claude API (fallback AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key

# =====================================================
# Email Service - Resend
# =====================================================
# Site mail sends from notifications@globepilots.com.
# Public contact is hello@globepilots.com (Cloudflare Email Routing -> Gmail).
# Provider applications (Kiwi, Pexels, etc.) use api@globepilots.com via Gmail Send mail as.
# RESEND_API_KEY = Resend full-access key (Vercel Production + Preview + Development).
# Do not put the Resend "Gmail_Send_As" sending-only token here or in Vercel; it is Gmail's SMTP password only.
RESEND_API_KEY=your_resend_api_key

# =====================================================
# Cron Jobs
# =====================================================
# Secret key for authenticating cron job requests
# Generate a random secret: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# =====================================================
# Destination Enrichment APIs (Optional — graceful degradation)
# =====================================================
# Pexels — destination photos (20K req/month free)
# Sign up at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# RapidAPI — used for Meteostat climate data (500 req/month free)
# Sign up at https://rapidapi.com/meteostat/api/meteostat
# RAPIDAPI_KEY=your_rapidapi_key

# Note: REST Countries, Frankfurter, US State Dept, and Nager.Date
# are free APIs that require no API keys.

# =====================================================
# Optional: SMS Notifications (Future Enhancement)
# =====================================================
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# =====================================================
# Optional analytics
# =====================================================
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# Public browser token (safe to expose; do not use a PostHog personal API key)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# Use the host shown by your PostHog project (EU or US region)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# =====================================================
# Additional runtime settings and optional providers
# =====================================================
# Canonical URLs used by server-generated links and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CONTACT_EMAIL=hello@globepilots.com

# Optional providers referenced by the application (server-only secrets)
AERODATABOX_API_KEY=
AMADEUS_HOSTNAME=test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
FLIGHTAPI_KEY=
FLIGHTAPI_CREDITS=30
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Duffel integration (server-only; leave blank unless enabled)
DUFFEL_ENV=test
DUFFEL_TEST_TOKEN=
DUFFEL_LIVE_TOKEN=
DUFFEL_API_KEY=

# Server-only Supabase admin key. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================
# Setup Instructions:
# =====================================================
# 1. Supabase:
#    - Create project at supabase.com
#    - Run both SQL files in SQL Editor:
#      - supabase-schema-enhancements.sql
#      - supabase-user-accounts-schema.sql
#    - Get URL and anon key from Settings > API
#
# 2. TravelPayouts:
#    - Sign up at travelpayouts.com
#    - Get API token from dashboard
#    - Create marker for affiliate tracking
#
# 3. DeepSeek:
#    - Sign up at deepseek.com
#    - Get API key from dashboard
#
# 4. Resend:
#    - Sign up at resend.com
#    - Verify your domain (or use onboarding domain for testing)
#    - Get API key from API Keys section
#
# 5. NextAuth:
#    - Generate NEXTAUTH_SECRET: openssl rand -base64 32
#    - Set NEXTAUTH_URL to your domain (http://localhost:3000 for dev)
#
# 6. Google OAuth (Optional):
#    - Go to Google Cloud Console
#    - Create OAuth 2.0 credentials
#    - Add authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
#
# 7. Cron Jobs:
#    - Generate CRON_SECRET: openssl rand -base64 32
#    - In Vercel, cron jobs run automatically based on vercel.json
#    - Add CRON_SECRET to both .env.local and Vercel environment variables
#
# =====================================================
